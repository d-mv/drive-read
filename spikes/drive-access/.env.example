# Google Cloud values for the spike (not secrets; they ship in the app bundle later).
# OAuth client ID (type Web), authorized JavaScript origin: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=
# API key restricted to http://localhost:5173, Picker API enabled
VITE_GOOGLE_API_KEY=
# Project number (not project ID); the Picker needs it to grant drive.file access
VITE_GOOGLE_APP_ID=
