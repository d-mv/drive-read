# Logger API (https://logger-api.mlnkv.net). The key ships in the bundle: write-only, rate-limited.
VITE_LOGGER_API_BASE_URL=https://logger-api.mlnkv.net/api
VITE_LOGGER_INGEST_KEY=
# Google OAuth client ID (Build 4, Drive API with drive.readonly + drive.appdata). Not a secret.
# No API key: Drive calls carry the user's OAuth token. No client secret: browser token flow.
VITE_GOOGLE_CLIENT_ID=
# Desktop app only (docs/DESKTOP.md): a "Desktop app" OAuth client in the same Google project.
# Baked into the Electron main process by desktop/build.ts, never into the web bundle (no VITE_).
DESKTOP_GOOGLE_CLIENT_ID=
DESKTOP_GOOGLE_CLIENT_SECRET=
